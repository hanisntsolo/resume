---
import BaseLayout from '../layouts/BaseLayout.astro'
import {
  latestJobs,
  timelineEvents,
  formatDateRange,
  calculateDuration,
  calculateTotalExperience,
  isCurrentEvent
} from '../lib/timeline'

const totalExperience = calculateTotalExperience(timelineEvents)
const currentRole = latestJobs.find((job) => isCurrentEvent(job)) || latestJobs[0]
const pageTitle = 'Dhirendra Pratap Singh | Full Stack Java Developer Resume and Timeline'
const pageDescription = 'Astro portfolio-resume site for Dhirendra Pratap Singh, featuring cloud-native engineering highlights, timeline, and downloadable resume assets.'
const pageKeywords = 'Dhirendra Pratap Singh, Full Stack Java Developer, cloud-native engineering, distributed systems, resume, experience timeline'
const pageSocialImage = 'https://github.com/hanisntsolo.png?size=1200'

const profileSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': 'https://resume.hanisntsolo.com/#profile',
      name: 'Dhirendra Pratap Singh Resume',
      url: 'https://resume.hanisntsolo.com/',
      inLanguage: 'en-US',
      isPartOf: {
        '@id': 'https://resume.hanisntsolo.com/#website'
      },
      about: {
        '@id': 'https://resume.hanisntsolo.com/#person'
      },
      mainEntity: {
        '@id': 'https://resume.hanisntsolo.com/#person'
      }
    }
  ]
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonicalPath={Astro.url.pathname}
  ogType="profile"
  ogImage={pageSocialImage}
  ogImageAlt="Dhirendra Pratap Singh - Full Stack Java Developer"
  schema={profileSchema}
>
  <canvas id="force-graph-bg" aria-hidden="true"></canvas>
  <main class="shell home-shell">
    <section class="hero-card glass reveal">
      <p class="eyebrow">Focused on distributed systems and product velocity</p>
      <h1 class="name-heading">
        <span>Dhirendra Pratap Singh</span>
        <a
          class="profile-avatar-link"
          href="https://github.com/hanisntsolo"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View GitHub profile"
        >
          <img
            class="profile-avatar"
            src="https://github.com/hanisntsolo.png?size=160"
            alt="Dhirendra Pratap Singh profile avatar"
            width="60"
            height="60"
            loading="eager"
            decoding="async"
            referrerpolicy="no-referrer"
          />
        </a>
      </h1>
      <p class="lead">
        Full Stack Java Developer building resilient fintech platforms, cloud-native services,
        and delivery pipelines that scale under production pressure.
      </p>

      <div class="cta-row">
        <a class="btn btn-primary" href="timeline/">Explore full timeline</a>
        <a class="btn btn-soft" href="hanisntsolo-resume.pdf" data-track-resume-download download>
          Download resume
        </a>
        <a class="btn btn-soft" href="hanisntsolo-resume.pdf#view=FitH" target="_blank" rel="noopener noreferrer">
          Open resume
        </a>
      </div>

      <ul class="social-strip" aria-label="Professional profiles">
        <li><a href="https://hanisntsolo.com" target="_blank" rel="noopener noreferrer">Portfolio</a></li>
        <li><a href="https://github.com/hanisntsolo" target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/hanisntsolo" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a href="mailto:ds.pratap1997@gmail.com">Email</a></li>
      </ul>
    </section>

    <section class="stats-grid reveal delay-1" aria-label="Profile metrics">
      <article class="metric-card">
        <p class="metric-label">Total Experience</p>
        <p class="metric-value">{totalExperience}</p>
        <p class="metric-note">Across engineering, platform, and product delivery</p>
      </article>
      <article class="metric-card">
        <p class="metric-label">Current Focus</p>
        <p class="metric-value">{currentRole?.company || 'Engineering Leadership'}</p>
        <p class="metric-note">{currentRole?.title || 'Full stack and cloud-native delivery'}</p>
      </article>
      <article class="metric-card">
        <p class="metric-label">Resume Downloads</p>
        <p class="metric-value" id="downloadCount">Loading...</p>
        <p class="metric-note">Tracked via GoatCounter events</p>
      </article>
    </section>

    <section class="experience-panel glass reveal delay-2" aria-label="Recent professional experience">
      <header class="section-header">
        <h2>Professional highlights</h2>
        <p>Recent roles and impact snapshots</p>
      </header>

      <div class="experience-grid">
        {latestJobs.map((job, index) => (
          <article class="experience-item" style={`--delay:${120 + (index * 80)}ms`}>
            <h3>{job.title}</h3>
            <div class="company-row">
              <strong>{job.company}</strong>
              {isCurrentEvent(job) && <span class="current-pill">Current</span>}
            </div>
            <p class="meta">
              {formatDateRange(job)}
              {' '}
              ({calculateDuration(job.date, job.endDate)})
            </p>
            <p class="summary">{job.description}</p>
            <div class="stack">
              {(job.technologies || []).slice(0, 6).map((tech) => (
                <span>{tech}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="document-studio glass reveal delay-3" aria-label="Document preview studio">
      <header class="section-header">
        <h2>Document studio</h2>
        <p>Preview and share resume assets directly</p>
      </header>

      <div class="doc-controls">
        <div class="doc-switch" role="tablist" aria-label="Switch document preview">
          <button type="button" class="active" data-doc="resume" aria-selected="true">Resume</button>
          <button type="button" data-doc="cover-letter" aria-selected="false">Cover Letter</button>
        </div>

        <div class="doc-actions">
          <a id="docDownloadButton" class="btn btn-primary" href="hanisntsolo-resume.pdf" data-track-resume-download download>
            Download current PDF
          </a>
          <a id="docOpenButton" class="btn btn-soft" href="hanisntsolo-resume.pdf#view=FitH" target="_blank" rel="noopener noreferrer">
            Open full screen
          </a>
        </div>
      </div>

      <div class="doc-frame-wrap">
        <iframe
          id="documentFrame"
          src="hanisntsolo-resume.pdf#view=FitH"
          title="Resume and cover letter preview"
          loading="lazy"
        ></iframe>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const DOWNLOAD_EVENT_PATH = '/resume-download'
      const countNode = document.getElementById('downloadCount')
      const frame = document.getElementById('documentFrame')
      const openButton = document.getElementById('docOpenButton')
      const downloadButton = document.getElementById('docDownloadButton')
      const switchButtons = Array.from(document.querySelectorAll('[data-doc]'))

      const docs = {
        resume: 'hanisntsolo-resume.pdf',
        'cover-letter': 'hanisntsolo-cover-letter.pdf'
      }

      const alternateDocs = {
        resume: ['hanisntsolo-resume.pdf'],
        'cover-letter': ['hanisntsolo-cover-letter.pdf', 'hanisntsolo-cover-letter.pdf.1']
      }

      const checkAsset = async (path) => {
        try {
          const response = await fetch(path, { method: 'HEAD' })
          return response.ok
        } catch {
          return false
        }
      }

      const resolvePath = async (key) => {
        const candidates = alternateDocs[key] || [docs[key]]
        for (const candidate of candidates) {
          if (await checkAsset(candidate)) {
            return candidate
          }
        }

        return docs[key]
      }

      const trackResumeDownload = () => {
        if (window.goatcounter && typeof window.goatcounter.count === 'function') {
          window.goatcounter.count({
            path: DOWNLOAD_EVENT_PATH,
            title: 'resume-download',
            event: true
          })
        }
      }

      const updateDocument = async (key) => {
        const path = await resolvePath(key)
        frame.src = `${path}#view=FitH`
        openButton.href = `${path}#view=FitH`
        downloadButton.href = path
      }

      const setActiveButton = (activeKey) => {
        switchButtons.forEach((button) => {
          const isActive = button.dataset.doc === activeKey
          button.classList.toggle('active', isActive)
          button.setAttribute('aria-selected', isActive ? 'true' : 'false')
        })
      }

      switchButtons.forEach((button) => {
        button.addEventListener('click', async () => {
          const docKey = button.dataset.doc
          setActiveButton(docKey)
          await updateDocument(docKey)
        })
      })

      document.querySelectorAll('[data-track-resume-download]').forEach((link) => {
        link.addEventListener('click', trackResumeDownload)
      })

      const loadDownloadCount = async () => {
        const endpoint = 'https://hanisntsolo.goatcounter.com/counter/' + encodeURIComponent(DOWNLOAD_EVENT_PATH) + '.json'

        try {
          const response = await fetch(endpoint, { mode: 'cors' })
          if (!response.ok) {
            throw new Error('Counter endpoint unavailable')
          }

          const payload = await response.json()
          const count = typeof payload.count === 'number' ? payload.count : null
          countNode.textContent = count === null ? 'n/a' : count.toLocaleString()
        } catch {
          countNode.textContent = 'Available in GoatCounter dashboard'
        }
      }

      void updateDocument('resume')
      void loadDownloadCount()
    })()
  </script>

  <!-- D3 Force Graph Background -->
  <style>
    #force-graph-bg {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      z-index: 0;
      pointer-events: none;
    }

    .home-shell {
      position: relative;
      z-index: 1;
    }

    /* Tooltip for graph hint */
    #graph-hint {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      background: rgba(14, 24, 40, 0.82);
      border: 1px solid rgba(92, 200, 255, 0.25);
      border-radius: 10px;
      padding: 0.55rem 0.9rem;
      font-size: 0.72rem;
      color: rgba(156, 174, 208, 0.75);
      pointer-events: none;
      z-index: 10;
      backdrop-filter: blur(8px);
      line-height: 1.55;
      max-width: 220px;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    #graph-hint.visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <div id="graph-hint">
    <strong style="color: rgba(92,200,255,0.9)">Graph is live</strong><br/>
    Hover to attract · Click node to pin &amp; spawn · Drag to move · Double-click to unpin
  </div>

  <script type="module" is:inline>
    (async () => {
      const d3 = await import('https://cdn.jsdelivr.net/npm/d3@7/+esm')

      const canvas = document.getElementById('force-graph-bg')
      const ctx = canvas.getContext('2d')

      let W = window.innerWidth
      let H = window.innerHeight
      canvas.width = W
      canvas.height = H

      // Content column width mirrors the CSS: min(1140px, 92vw)
      const contentW = () => Math.min(1140, W * 0.92)
      // Left/right gutter centres — where the flanks live
      const leftAnchor  = () => contentW() < W ? (W - contentW()) / 4 : W * 0.1
      const rightAnchor = () => W - leftAnchor()
      // Content zone exclusion band
      const contentLeft  = () => (W - contentW()) / 2 - 32
      const contentRight = () => W - contentLeft()

      // ── Palette: [r, g, b] matching the site theme ──────────────────────
      const PALETTE = [
        [92, 200, 255],   // accent blue
        [61, 224, 200],   // accent teal
        [255, 189, 89],   // accent orange
        [255, 111, 122],  // pink/red
        [167, 139, 250],  // purple
      ]

      // ── Seed nodes (side: 'left' | 'right') ─────────────────────────────
      const SEED = [
        { label: 'Java',            g: 0, side: 'left'  },
        { label: 'Spring Boot',     g: 0, side: 'left'  },
        { label: 'Microservices',   g: 0, side: 'left'  },
        { label: 'Distributed Sys', g: 0, side: 'left'  },
        { label: 'AWS',             g: 1, side: 'left'  },
        { label: 'Docker',          g: 1, side: 'left'  },
        { label: 'Kubernetes',      g: 1, side: 'left'  },
        { label: 'Redis',           g: 1, side: 'left'  },
        { label: 'Kafka',           g: 1, side: 'left'  },
        { label: 'Cloud Native',    g: 1, side: 'left'  },
        { label: 'CI/CD',           g: 3, side: 'left'  },
        { label: 'Linux',           g: 3, side: 'left'  },
        { label: 'Git',             g: 3, side: 'left'  },
        { label: 'REST API',        g: 0, side: 'right' },
        { label: 'React',           g: 2, side: 'right' },
        { label: 'TypeScript',      g: 2, side: 'right' },
        { label: 'Node.js',         g: 2, side: 'right' },
        { label: 'GraphQL',         g: 2, side: 'right' },
        { label: 'PostgreSQL',      g: 1, side: 'right' },
        { label: 'Agile',           g: 3, side: 'right' },
        { label: 'DSA',             g: 4, side: 'right' },
        { label: 'Algorithms',      g: 4, side: 'right' },
        { label: 'Data Structures', g: 4, side: 'right' },
        { label: 'Binary Search',   g: 4, side: 'right' },
        { label: 'Fintech',         g: 4, side: 'right' },
      ]

      let uid = 0

      // Place node within its side's flank band on first spawn
      const sideX = (side) => {
        const cl = contentLeft()
        if (side === 'left')  return Math.random() * (cl - 20) + 10
        else                  return contentRight() + Math.random() * (W - contentRight() - 10)
      }

      const makeNode = (label, g, side, x, y) => {
        const rgb = PALETTE[g % PALETTE.length]
        const ns  = side ?? (Math.random() < 0.5 ? 'left' : 'right')
        return {
          id: uid++, label, g, side: ns, rgb,
          r: 5 + Math.random() * 9,
          x: x ?? sideX(ns),
          y: y ?? H * (0.08 + Math.random() * 0.84),
          vx: 0, vy: 0,
          fx: null, fy: null,
          _wa: Math.random() * Math.PI * 2,   // wander angle
        }
      }

      const nodes = SEED.map(({ label, g, side }) => makeNode(label, g, side))
      const links = []

      // Within-group links
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          if (nodes[i].g === nodes[j].g) links.push({ source: nodes[i], target: nodes[j] })
        }
      }
      // Cross-group links (same side only to avoid crossing the content column)
      const cross = [
        [0, 4], [0, 3], [1, 5], [1, 6], [4, 5], [7, 4], [8, 7], [10, 11],
        [13, 18], [13, 14], [14, 15], [16, 17], [20, 21], [20, 22], [21, 23],
      ]
      cross.forEach(([a, b]) => {
        if (nodes[a] && nodes[b] && nodes[a].side === nodes[b].side)
          links.push({ source: nodes[a], target: nodes[b] })
      })

      // ── Simulation ───────────────────────────────────────────────────────
      const sim = d3.forceSimulation(nodes)
        .force('link',    d3.forceLink(links).distance(78).strength(0.25))
        .force('charge',  d3.forceManyBody().strength(-90).distanceMax(240))
        // Soft flank attractor — weak enough that wander dominates in idle
        .force('x',       d3.forceX(n => n.side === 'left' ? leftAnchor() : rightAnchor()).strength(0.015))
        .force('y',       d3.forceY(H * 0.5).strength(0.006))
        .force('collide', d3.forceCollide(n => n.r + 9).strength(0.65))
        .alphaDecay(0.007)
        .alphaTarget(0.05)   // never fully settle — always ticking
        .velocityDecay(0.28) // less damping so wander can breathe
        .on('tick', draw)

      // Soft content-column avoidance
      sim.force('avoid-center', () => {
        const cl = contentLeft()
        const cr = contentRight()
        nodes.forEach(n => {
          if (n.fx != null) return
          if (n.x > cl && n.x < cr) {
            if (n.side === 'left') n.vx -= 0.55
            else                   n.vx += 0.55
          }
        })
      })

      // Elastic screen boundary walls
      sim.force('bounds', () => {
        const m = 30
        nodes.forEach(n => {
          if (n.fx != null) return
          if (n.x < m)       n.vx += (m - n.x) * 0.14
          if (n.x > W - m)   n.vx -= (n.x - (W - m)) * 0.14
          if (n.y < m)       n.vy += (m - n.y) * 0.14
          if (n.y > H - m)   n.vy -= (n.y - (H - m)) * 0.14
        })
      })

      // Wander: smooth flowing entropy — each node drifts on a slowly-rotating angle
      sim.force('wander', () => {
        nodes.forEach(n => {
          if (n.fx != null) return
          // Nudge wander angle by a small random step (Brownian rotation)
          n._wa += (Math.random() - 0.5) * 0.09
          n.vx += Math.cos(n._wa) * 0.36
          n.vy += Math.sin(n._wa) * 0.36
        })
      })

      // Mouse-attraction custom force
      let mx = -9999, my = -9999
      sim.force('mouse', () => {
        if (mx < -100) return
        nodes.forEach(n => {
          if (n === dragNode) return
          const dx = mx - n.x, dy = my - n.y
          const d2 = dx * dx + dy * dy
          if (d2 < 220 * 220 && d2 > 0) {
            const dist = Math.sqrt(d2)
            const s = 0.35 * (1 - dist / 220)
            n.vx += (dx / dist) * s
            n.vy += (dy / dist) * s
          }
        })
      })

      // ── Interaction state ────────────────────────────────────────────────
      let hovNode  = null
      let dragNode = null
      let dragMoved = false

      const hitTest = (x, y) =>
        nodes.find(n => {
          const dx = x - n.x, dy = y - n.y
          return dx * dx + dy * dy <= (n.r + 6) * (n.r + 6)
        }) ?? null

      // ── Render ───────────────────────────────────────────────────────────
      function draw () {
        ctx.clearRect(0, 0, W, H)

        // Links
        links.forEach(lk => {
          const s = lk.source, t = lk.target
          const lit = hovNode && (s === hovNode || t === hovNode)
          ctx.beginPath()
          ctx.moveTo(s.x, s.y)
          ctx.lineTo(t.x, t.y)
          ctx.strokeStyle = lit
            ? `rgba(${s.rgb.join(',')}, 0.52)`
            : `rgba(92,200,255,0.07)`
          ctx.lineWidth = lit ? 1.5 : 0.7
          ctx.stroke()
        })

        // Nodes
        nodes.forEach(n => {
          const hov    = n === hovNode
          const pinned = n.fx != null
          const r      = hov ? n.r * 1.55 : n.r
          const [rc, gc, bc] = n.rgb

          // Glow aura
          if (hov || pinned) {
            const gr = ctx.createRadialGradient(n.x, n.y, r * 0.3, n.x, n.y, r + 18)
            const glowRgb = pinned ? [61, 224, 200] : [rc, gc, bc]
            gr.addColorStop(0, `rgba(${glowRgb.join(',')}, 0.38)`)
            gr.addColorStop(1, `rgba(${glowRgb.join(',')}, 0)`)
            ctx.beginPath()
            ctx.arc(n.x, n.y, r + 18, 0, 2 * Math.PI)
            ctx.fillStyle = gr
            ctx.fill()
          }

          // Circle fill
          ctx.beginPath()
          ctx.arc(n.x, n.y, r, 0, 2 * Math.PI)
          ctx.fillStyle = hov
            ? `rgba(${rc},${gc},${bc}, 0.85)`
            : pinned
              ? `rgba(61,224,200, 0.42)`
              : `rgba(${rc},${gc},${bc}, 0.17)`
          ctx.fill()

          // Border
          ctx.strokeStyle = hov
            ? `rgba(${rc},${gc},${bc}, 1)`
            : pinned
              ? `rgba(61,224,200, 0.9)`
              : `rgba(${rc},${gc},${bc}, 0.4)`
          ctx.lineWidth = hov || pinned ? 1.5 : 0.8
          ctx.stroke()

          // Pin indicator dot
          if (pinned) {
            ctx.beginPath()
            ctx.arc(n.x, n.y, 2.5, 0, 2 * Math.PI)
            ctx.fillStyle = 'rgba(61,224,200,0.95)'
            ctx.fill()
          }

          // Label
          if (hov || r > 9) {
            const fs = hov ? 11 : 8
            ctx.font = `${hov ? 600 : 400} ${fs}px Manrope, sans-serif`
            ctx.textAlign = 'center'
            ctx.textBaseline = hov ? 'bottom' : 'middle'
            ctx.fillStyle = hov
              ? '#e9eef9'
              : `rgba(233,238,249,${pinned ? 0.85 : 0.45})`
            ctx.fillText(n.label, n.x, hov ? n.y - r - 5 : n.y)
          }
        })
      }

      // ── Spawn helpers ────────────────────────────────────────────────────
      const SPAWN_LABELS = [
        'Graph', 'Tree', 'HashMap', 'Queue', 'Stack', 'BFS', 'DFS',
        'Dynamic Prog', 'Heap', 'Trie', 'Recursion', 'Greedy', 'O(n log n)',
        'Sorting', 'Pointer', 'Array', 'Cache', 'Thread', 'Socket',
        'Index', 'Schema', 'Query', 'Buffer', 'Linked List', 'Binary Tree',
      ]
      let spawnIdx = 0

      const spawnNode = (x, y, parent) => {
        const g    = parent ? parent.g : Math.floor(Math.random() * 5)
        const side = parent ? parent.side : (x < W / 2 ? 'left' : 'right')
        const lbl  = SPAWN_LABELS[spawnIdx++ % SPAWN_LABELS.length]
        const nn   = makeNode(lbl, g, side, x, y)
        nodes.push(nn)
        if (parent) links.push({ source: parent, target: nn })
        sim.nodes(nodes)
        sim.force('link').links(links)
        sim.alpha(0.5).restart()
      }

      // ── Window-level events (canvas is pointer-events:none) ──────────────
      window.addEventListener('mousemove', e => {
        mx = e.clientX
        my = e.clientY
        if (dragNode) {
          dragNode.fx = mx
          dragNode.fy = my
          dragMoved = true
          sim.alphaTarget(0.18).restart()
        } else {
          const prev = hovNode
          hovNode = hitTest(mx, my)
          if (hovNode !== prev) {
            document.body.style.cursor = hovNode ? 'grab' : ''
            if (hovNode) sim.alphaTarget(0.08).restart()
          }
        }
      }, { passive: true })

      window.addEventListener('mousedown', e => {
        const node = hitTest(e.clientX, e.clientY)
        dragMoved = false
        if (node) {
          e.preventDefault()
          dragNode = node
          node.fx = node.x
          node.fy = node.y
          document.body.style.cursor = 'grabbing'
          sim.alphaTarget(0.3).restart()
        }
      })

      window.addEventListener('mouseup', e => {
        const x = e.clientX, y = e.clientY
        if (dragNode) {
          if (!dragMoved) {
            // Click on node → keep pinned, spawn child
            dragNode.fx = dragNode.x
            dragNode.fy = dragNode.y
            const angle = Math.random() * 2 * Math.PI
            const dist  = 72 + Math.random() * 52
            spawnNode(
              dragNode.x + Math.cos(angle) * dist,
              dragNode.y + Math.sin(angle) * dist,
              dragNode,
            )
          } else {
            // Drag ended → keep pinned at drop position
            dragNode.fx = x
            dragNode.fy = y
          }
          document.body.style.cursor = hovNode ? 'grab' : ''
        } else if (!dragMoved) {
          // Click on empty space → spawn free node (skip if on UI element)
          const el = document.elementFromPoint(x, y)
          if (!el || !el.closest('a,button,input,select,textarea,iframe,[data-interactive]')) {
            spawnNode(x, y, null)
          }
        }
        dragNode  = null
        dragMoved = false
        sim.alphaTarget(0.05)  // back to idle wander
      })

      // Double-click to unpin
      window.addEventListener('dblclick', e => {
        const node = hitTest(e.clientX, e.clientY)
        if (node) {
          node.fx = null
          node.fy = null
          sim.alpha(0.3).restart()
        }
      })

      window.addEventListener('mouseleave', () => {
        mx = -9999; my = -9999
        hovNode = null
        if (dragNode) { dragNode.fx = null; dragNode.fy = null; dragNode = null }
        sim.alphaTarget(0.05)  // back to idle wander
        document.body.style.cursor = ''
      }, { passive: true })

      window.addEventListener('resize', () => {
        W = window.innerWidth; H = window.innerHeight
        canvas.width = W; canvas.height = H
        sim.force('x', d3.forceX(n => n.side === 'left' ? leftAnchor() : rightAnchor()).strength(0.015))
        sim.force('y', d3.forceY(H * 0.5).strength(0.006))
        sim.alpha(0.3)
      }, { passive: true })

      // Show hint briefly after load
      const hint = document.getElementById('graph-hint')
      if (hint) {
        setTimeout(() => hint.classList.add('visible'), 1200)
        setTimeout(() => hint.classList.remove('visible'), 7000)
      }
    })()
  </script>
</BaseLayout>
